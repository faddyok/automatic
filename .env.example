# Required
BOT_TOKEN=123456789:replace_with_your_bot_token

# Strongly recommended: only this Telegram user ID can operate the bot.
# Send /whoami to the bot after first deploy to see your ID, then set this variable.
ALLOWED_TELEGRAM_ID=

# The landing URL from your current promotion.
LANDING_URL=https://landing.brazzersnetwork.com/?ats=eyJhIjoyODc2NDUsImMiOjU2NTA2NDU4LCJuIjoxNCwicyI6OTAsImUiOjg4MDMsInAiOjMzOX0%3D&atc=Autocampaign_Default&apb=23e52e0c40074a70%7Cbrazzers

# Railway supplies PORT automatically. Locally it defaults to 3000.
PORT=3000

# Optional
HEADLESS=true
SEND_CHECKOUT_SCREENSHOT=true
